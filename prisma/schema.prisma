generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          UserRole       @default(EMPLOYEE)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  client        Client?
  employee      Employee?
  notifications Notification[]
}

model Employee {
  id                String             @id @default(cuid())
  userId            String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoDeliverables VideoDeliverable[]
  scripts           Script[]
}

model Client {
  id                String             @id @default(cuid())
  userId            String             @unique
  companyName       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders            Order[]
  scripts           Script[]
  shoots            Shoot[]
  videoDeliverables VideoDeliverable[]
  payments          Payment[]
  scriptFeedbacks   ScriptFeedback[]
}

model Order {
  id                   String             @id @default(cuid())
  clientId             String
  packageName          String
  contractedVideoCount Int
  pricing              Decimal            @db.Decimal(12, 2)
  gstTax               Decimal            @db.Decimal(12, 2)
  totalInvoiceAmount   Decimal            @db.Decimal(12, 2)
  amountReceived       Decimal            @default(0) @db.Decimal(12, 2)
  outstandingBalance   Decimal            @db.Decimal(12, 2)
  startDate            DateTime
  dueDate              DateTime
  status               OrderStatus        @default(NEW)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scripts              Script[]
  shoots               Shoot[]
  videoDeliverables    VideoDeliverable[]
  payments             Payment[]
}

model Script {
  id             String       @id @default(cuid())
  clientId       String
  orderId        String
  writerId       String?
  videoNumber    Int
  language       String
  scriptText     String
  referenceLinks String?
  deadline       DateTime
  revisionCount  Int          @default(0)
  comments       String?
  status         ScriptStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  creatorId      String?

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  writer            Employee?          @relation(fields: [writerId], references: [id])
  creator           Creator?           @relation(fields: [creatorId], references: [id])
  videoDeliverables VideoDeliverable[]
  feedbacks         ScriptFeedback[]
}

model ScriptFeedback {
  id        String               @id @default(cuid())
  scriptId  String
  clientId  String
  action    ScriptFeedbackAction
  comment   String?
  createdAt DateTime             @default(now())

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([scriptId])
  @@index([clientId])
  @@index([createdAt])
}

enum ScriptFeedbackAction {
  APPROVED
  REVISION_REQUIRED
}

model Creator {
  id                String                @id @default(cuid())
  name              String
  specialty         String
  languages         String
  platform          String
  location          String
  rate              Decimal               @db.Decimal(12, 2)
  status            CreatorStatus         @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  availability      CreatorAvailability[]
  scripts           Script[]
  shoots            Shoot[]
  videoDeliverables VideoDeliverable[]
  payouts           CreatorPayout[]
}

model CreatorAvailability {
  id        String                    @id @default(cuid())
  creatorId String
  date      DateTime
  status    CreatorAvailabilityStatus @default(AVAILABLE)
  notes     String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  creator   Creator                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, date])
}

model Shoot {
  id                      String             @id @default(cuid())
  clientId                String
  orderId                 String
  creatorId               String
  dateTime                DateTime
  location                String
  cameraman               String?
  shootManager            String?
  shootingAssistant       String?
  approvedScripts         String?
  specialNotes            String?
  status                  ShootStatus        @default(SCHEDULED)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  footageUploadVerified   Boolean            @default(false)
  rawFileIntegrityChecked Boolean            @default(false)
  reshootRequired         Boolean            @default(false)
  client                  Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator                 Creator            @relation(fields: [creatorId], references: [id])
  order                   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  videoDeliverables       VideoDeliverable[]
}

model VideoDeliverable {
  id                String                 @id @default(cuid())
  clientId          String
  orderId           String
  scriptId          String?
  creatorId         String?
  shootId           String?
  assignedEditorId  String?
  videoNumber       Int
  title             String
  status            VideoDeliverableStatus @default(SCRIPT_APPROVED)
  deadline          DateTime?
  videoFileLink     String?
  thumbnail         String?
  clientFeedbackLog String?
  revisionCount     Int                    @default(0)
  finalDeliveryLink String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  script         Script?   @relation(fields: [scriptId], references: [id])
  creator        Creator?  @relation(fields: [creatorId], references: [id])
  shoot          Shoot?    @relation(fields: [shootId], references: [id])
  assignedEditor Employee? @relation(fields: [assignedEditorId], references: [id])
}

enum UserRole {
  OWNER
  ADMIN
  EMPLOYEE
  CLIENT
}

enum OrderStatus {
  NEW
  ONBOARDING
  IN_PRODUCTION
  PARTIALLY_DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ScriptStatus {
  DRAFT
  ASSIGNED
  IN_REVIEW
  SENT_TO_CLIENT
  REVISION_REQUIRED
  APPROVED
  READY_FOR_SHOOT
}

enum CreatorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CreatorAvailabilityStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum ShootStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESHOOT_REQUIRED
}

enum VideoDeliverableStatus {
  SCRIPT_APPROVED
  SHOOT_PENDING
  RAW_FOOTAGE_RECEIVED
  VIDEO_EDITING
  INTERNAL_QA
  CLIENT_REVIEW
  REVISION
  FINAL_APPROVED
  DELIVERED
}

model Payment {
  id            String   @id @default(cuid())
  clientId      String
  orderId       String
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @default(now())
  paymentMethod String?
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String   @id @default(cuid())
  category      String
  description   String?
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime
  paymentMethod String?
  receiptLink   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model CreatorPayout {
  id            String   @id @default(cuid())
  creatorId     String
  amount        Decimal  @db.Decimal(12, 2)
  payoutDate    DateTime @default(now())
  paymentMethod String?
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

enum TaskPriority {
  URGENT
  HIGH
  MED
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  assigneeId  String?
  priority    TaskPriority @default(MED)
  deadline    DateTime?
  attachment  String?
  status      TaskStatus   @default(TODO)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
